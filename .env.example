POSTGRES_DB=findx
POSTGRES_USER=findx
POSTGRES_PASSWORD=replace-with-local-db-password
ADMIN_KEY=replace-with-local-admin-key
DATABASE_URL=postgresql+psycopg://findx:replace-with-local-db-password@localhost:5432/findx
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# Default fallback mode. Set both variables below for FULL ML Docker builds.
FINDX_MODE=lightweight
FINDX_INSTALL_FULL=0
FINDX_DEVICE=auto

# FULL multimodal fusion weights. The runtime renormalizes enabled terms.
FINDX_MM_VISUAL_WEIGHT=0.50
FINDX_MM_TEXT_WEIGHT=0.20
FINDX_MM_CROSSMODAL_WEIGHT=0.20
FINDX_MM_ATTRIBUTE_WEIGHT=0.10

# Optional model/cache overrides for FULL mode.
# SENTENCE_TRANSFORMERS_HOME=C:/Users/you/.cache/findx/sentence-transformers
# OPENCLIP_CACHE_DIR=C:/Users/you/.cache/findx/openclip
# FINDX_DEVICE=auto
# FINDX_CLIP_BATCH_SIZE=16
